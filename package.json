{
  "name": "kinetic-battle-engine",
  "version": "1.3.6-stage8.5b",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "dev": "npm run dev --workspace @kinetic/game",
    "build": "npm run build --workspace @kinetic/game",
    "preview": "npm run preview --workspace @kinetic/game",
    "typecheck": "tsc --noEmit -p apps/game/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "mobile:sync": "npm run cap:sync --workspace @kinetic/game",
    "release:check": "npm run check && npm run mobile:sync"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
