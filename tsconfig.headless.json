{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "/tmp/kbe-v08-out",
    "rootDir": ".",
    "isolatedModules": false,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@kinetic/protocol": [
        "packages/protocol/src/index.ts"
      ],
      "@kinetic/content": [
        "packages/content/src/index.ts"
      ],
      "@kinetic/simulation": [
        "packages/simulation/src/index.ts"
      ],
      "@kinetic/controllers": [
        "packages/controllers/src/index.ts"
      ],
      "@kinetic/creator": [
        "packages/creator/src/index.ts"
      ],
      "@kinetic/visual-engine": [
        "packages/visual-engine/src/index.ts"
      ],
      "@kinetic/meta": [
        "packages/meta/src/index.ts"
      ],
      "@kinetic/platform": [
        "packages/platform/src/index.ts"
      ]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "/tmp/kbe-validation-stubs.d.ts",
    "packages/protocol/src/**/*.ts",
    "packages/content/src/**/*.ts",
    "packages/content/src/**/*.json",
    "packages/simulation/src/**/*.ts",
    "packages/controllers/src/**/*.ts",
    "validation/**/*.ts",
    "packages/visual-engine/src/**/*.ts",
    "packages/creator/src/**/*.ts",
    "packages/meta/src/**/*.ts",
    "packages/platform/src/**/*.ts"
  ]
